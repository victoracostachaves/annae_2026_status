# =============================================================================
# SUPPLEMENTARY CODE C: Environmental Maps + Population PCA for Agalychnis annae
# =============================================================================
# Original authors: Hector Zumbado and Victor Acosta
# Improved and standardized with assistance from DeepSeek (AI assistant)
# Date: 2026-05-25
#
# This script performs two main tasks:
# 1. Generates publication‑quality maps of environmental variables (19 bioclimatic
#    variables, elevation, Human Footprint Index, coffee cover) at 30 arc‑second
#    resolution, with occurrence records coloured by time period (pre‑2000 vs post‑2000).
# 2. Performs a PCA on environmental data extracted for three geographic populations
#    of A. annae (Tilarán‑Monteverde, Central Plateau, Fila Costeña‑San Vito)
#    plus background points, and produces biplots, boxplots, density plots,
#    Wilcoxon tests, and an Excel summary.
#
# Required input files (relative paths):
#   data/processed/Agalychnis_annae_full_dataset.rds  – cleaned occurrences
#   shapefiles/costa_rica_wgs84.gpkg                  – Costa Rica boundary
#   rasters/env_stack_annae_30s.tif                   – 22‑layer environmental stack
#
# Outputs (all created automatically):
#   output/figures/maps_30s/individual/  – one map per variable (PNG + PDF)
#   output/figures/maps_30s/variations/  – alternative backgrounds/palettes
#   output/figures/population_pca/       – PCA biplot, boxplots, density plots,
#                                          variable contributions, Excel results
# =============================================================================

# -----------------------------------------------------------------------------
# 0. SETUP
# -----------------------------------------------------------------------------

rm(list = ls())

# Load required packages
library(terra)
library(sf)
library(ggplot2)
library(ggspatial)
library(dplyr)
library(readr)
library(cowplot)
library(tidyr)
library(FactoMineR)
library(factoextra)
library(patchwork)
library(writexl)

# Create output directories
dir.create("output/figures/maps_30s/individual", recursive = TRUE, showWarnings = FALSE)
dir.create("output/figures/maps_30s/variations", recursive = TRUE, showWarnings = FALSE)
dir.create("output/figures/population_pca",      recursive = TRUE, showWarnings = FALSE)

# -----------------------------------------------------------------------------
# 1. LOAD SPATIAL DATA
# -----------------------------------------------------------------------------

cat("Loading shapefiles and occurrence data...\n")

# Costa Rica boundary
costa_rica <- st_read("shapefiles/costa_rica_wgs84.gpkg", quiet = TRUE)

# Occurrence records
occ_all <- read_rds("data/processed/Agalychnis_annae_full_dataset.rds") %>%
  filter(id != "Panama")   # keep only Costa Rica

# Split by time period for mapping
occ_pre  <- occ_all %>% filter(year < 2000)
occ_post <- occ_all %>% filter(year >= 2000)

n_pre  <- nrow(occ_pre)
n_post <- nrow(occ_post)

cat(sprintf("Pre-2000 records: %d\n", n_pre))
cat(sprintf("Post-2000 records: %d\n", n_post))

# Convert to sf (WGS84)
pre_sf  <- st_as_sf(occ_pre,  coords = c("x", "y"), crs = 4326)
post_sf <- st_as_sf(occ_post, coords = c("x", "y"), crs = 4326)

