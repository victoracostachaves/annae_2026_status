                legend.box = "vertical")
        
        var_dir <- file.path("output/figures/maps_30s/variations", bg_name, paste0("hfi_", pal_name))
        dir.create(var_dir, recursive = TRUE, showWarnings = FALSE)
        ggsave(file.path(var_dir, "map_hfi.png"), p_hfi, width = 7, height = 5.5, dpi = 300, bg = "white")
      }
    } else {
      var_dir <- file.path("output/figures/maps_30s/variations", bg_name)
      dir.create(var_dir, recursive = TRUE, showWarnings = FALSE)
      ggsave(file.path(var_dir, sprintf("map_%s.png", v)), p, width = 7, height = 5.5, dpi = 300, bg = "white")
    }
  }
}
cat("Variations complete.\n")

# =============================================================================
# PART II: POPULATION PCA
# =============================================================================

cat("\n\n=== STARTING POPULATION PCA ===\n")

# -----------------------------------------------------------------------------
# 7. Define populations (three geographic regions)
# -----------------------------------------------------------------------------

# Bounding boxes for each population
mv_bbox <- c(xmin = -84.90, xmax = -84.70, ymin = 10.20, ymax = 10.40)   # Tilarán-Monteverde
cp_bbox <- c(xmin = -84.30, xmax = -83.70, ymin = 9.70, ymax = 10.10)    # Central Plateau
sv_bbox <- c(xmin = -83.10, xmax = -82.90, ymin = 8.75, ymax = 8.95)      # Fila Costeña-San Vito

# Assign population labels to occurrences (using original x,y in WGS84)
occ_all <- occ_all %>%
  mutate(
    population = case_when(
      x >= mv_bbox["xmin"] & x <= mv_bbox["xmax"] &
        y >= mv_bbox["ymin"] & y <= mv_bbox["ymax"] ~ "Tilarán-Monteverde",
      x >= cp_bbox["xmin"] & x <= cp_bbox["xmax"] &
        y >= cp_bbox["ymin"] & y <= cp_bbox["ymax"] ~ "Central Plateau",
      x >= sv_bbox["xmin"] & x <= sv_bbox["xmax"] &
        y >= sv_bbox["ymin"] & y <= sv_bbox["ymax"] ~ "Fila Costeña-San Vito",
      TRUE ~ "Other"
    )
  )

cat("\nCounts by population:\n")
print(table(occ_all$population))

# -----------------------------------------------------------------------------
# 8. Prepare points for PCA (occurrences + background)
# -----------------------------------------------------------------------------

annae_sf <- st_as_sf(occ_all, coords = c("x", "y"), crs = 4326)

set.seed(123)
bg_points <- st_sample(costa_rica, size = 5000, type = "random")
bg_sf <- st_sf(geometry = bg_points)
bg_sf$population <- "Background"

all_points <- rbind(
  annae_sf %>% dplyr::select(population, geometry),
  bg_sf   %>% dplyr::select(population, geometry)
)

cat("\nTotal points for PCA:", nrow(all_points), "\n")
for (pop in c("Background", "Tilarán-Monteverde", "Central Plateau", "Fila Costeña-San Vito", "Other"))
  cat("  - ", pop, ":", sum(all_points$population == pop), "\n")

# -----------------------------------------------------------------------------
# 9. Extract environmental values (all layers except coffee)
# -----------------------------------------------------------------------------

all_vars <- names(env_stack)
pca_vars <- setdiff(all_vars, "coffee")
cat("\nNumber of variables used in PCA:", length(pca_vars), "\n")

# Build nice names for variables
nice_names <- c(
  "wc2.1_30s_bio_1"  = "Annual Mean Temp",
  "wc2.1_30s_bio_2"  = "Mean Diurnal Range",
  "wc2.1_30s_bio_3"  = "Isothermality",
  "wc2.1_30s_bio_4"  = "Temp Seasonality",
  "wc2.1_30s_bio_5"  = "Max Temp Warmest Month",
  "wc2.1_30s_bio_6"  = "Min Temp Coldest Month",
  "wc2.1_30s_bio_7"  = "Temp Annual Range",
  "wc2.1_30s_bio_8"  = "Mean Temp Wettest Quarter",
  "wc2.1_30s_bio_9"  = "Mean Temp Driest Quarter",
  "wc2.1_30s_bio_10" = "Mean Temp Warmest Quarter",
  "wc2.1_30s_bio_11" = "Mean Temp Coldest Quarter",
  "wc2.1_30s_bio_12" = "Annual Precipitation",
  "wc2.1_30s_bio_13" = "Precip Wettest Month",
  "wc2.1_30s_bio_14" = "Precip Driest Month",
  "wc2.1_30s_bio_15" = "Precip Seasonality",
  "wc2.1_30s_bio_16" = "Precip Wettest Quarter",
  "wc2.1_30s_bio_17" = "Precip Driest Quarter",
  "wc2.1_30s_bio_18" = "Precip Warmest Quarter",
  "wc2.1_30s_bio_19" = "Precip Coldest Quarter",
  "elevation" = "Elevation",
  "hfi"       = "Human Footprint Index"
)
nice_names <- nice_names[intersect(pca_vars, names(nice_names))]
missing <- setdiff(pca_vars, names(nice_names))
if (length(missing) > 0) {
  extra <- setNames(missing, missing)
  nice_names <- c(nice_names, extra)
}

# Project points to stack CRS and extract
all_points_proj <- st_transform(all_points, target_crs)
pca_data <- data.frame(population = all_points$population)

for (var in pca_vars) {
  cat("  Extracting:", var, "...")
  vals <- terra::extract(env_stack[[var]], vect(all_points_proj))[, 2]
  pca_data[[var]] <- vals
  cat(" done\n")
}

pca_data <- pca_data[complete.cases(pca_data), ]
cat("\nFinal PCA dataset:", nrow(pca_data), "points\n")

# -----------------------------------------------------------------------------
# 10. Perform PCA
# -----------------------------------------------------------------------------

cat("\nPerforming PCA...\n")
pca_result <- PCA(pca_data[, pca_vars], scale.unit = TRUE, graph = FALSE)

eig <- data.frame(
  PC = 1:nrow(pca_result$eig),
  Eigenvalue = pca_result$eig[,1],
  Variance_percent = round(pca_result$eig[,2], 2),
  Cumulative_percent = round(pca_result$eig[,3], 2)
)
cat("First 5 PCs:\n")
print(eig[1:5, ])

# Scores
pca_scores <- data.frame(
  PC1 = pca_result$ind$coord[,1],
  PC2 = pca_result$ind$coord[,2],
  population = pca_data$population
)

# Variable contributions
var_contrib <- as.data.frame(pca_result$var$contrib)
var_contrib$Variable <- rownames(var_contrib)
var_contrib$Nice_Name <- nice_names[var_contrib$Variable]
var_contrib <- var_contrib %>% arrange(desc(Dim.1))

# Long format for bar chart
contrib_long <- var_contrib %>%
  select(Nice_Name, Dim.1, Dim.2) %>%
  rename(Contribution_PC1 = Dim.1, Contribution_PC2 = Dim.2) %>%
  pivot_longer(cols = c(Contribution_PC1, Contribution_PC2),
               names_to = "Component", values_to = "Contribution") %>%
  mutate(Component = recode(Component, Contribution_PC1 = "PC1", Contribution_PC2 = "PC2"))

# Variable contributions plot
expected_contrib <- 100 / length(pca_vars)
top_contrib <- var_contrib %>% filter(Dim.1 > expected_contrib | Dim.2 > expected_contrib)
if(nrow(top_contrib) > 25) top_contrib <- top_contrib[1:25, ]

p_contrib <- ggplot(contrib_long %>% filter(Nice_Name %in% top_contrib$Nice_Name),
                    aes(x = reorder(Nice_Name, Contribution), y = Contribution, fill = Component)) +
  geom_col(position = position_dodge(width = 0.7), width = 0.6) +
  coord_flip() +
  scale_fill_manual(values = c("PC1" = "#1f78b4", "PC2" = "#33a02c")) +
  labs(title = "Variable contributions to PC1 and PC2",
       x = "", y = "Contribution (%)") +
  theme_minimal(base_size = 11) +
  theme(legend.position = "bottom")

ggsave("output/figures/population_pca/pca_variable_contributions.png", p_contrib,
       width = 10, height = 8, dpi = 300)

# -----------------------------------------------------------------------------
# 11. Biplot
# -----------------------------------------------------------------------------

target_pops <- c("Tilarán-Monteverde", "Central Plateau", "Fila Costeña-San Vito")
centroids <- pca_scores %>%
  filter(population %in% target_pops) %>%
  group_by(population) %>%
  summarise(PC1 = mean(PC1), PC2 = mean(PC2), n = n(), .groups = 'drop')

cat("\nCentroids:\n")
print(centroids)

# Scale arrows
var_coords_plot <- as.data.frame(pca_result$var$coord[, 1:2])
colnames(var_coords_plot) <- c("PC1", "PC2")
var_coords_plot$nice <- nice_names[rownames(var_coords_plot)]
max_point_range <- max(abs(pca_scores[, c("PC1","PC2")]))
max_var_range   <- max(abs(var_coords_plot[, c("PC1","PC2")]))
scale_factor <- 0.7 * max_point_range / max_var_range
var_coords_plot <- var_coords_plot %>%
  mutate(PC1_scaled = PC1 * scale_factor,
         PC2_scaled = PC2 * scale_factor)

x_lim <- max(abs(pca_scores$PC1)) * 1.2
y_lim <- max(abs(pca_scores$PC2)) * 1.2

pop_colors <- c("Background" = "gray75",
                "Tilarán-Monteverde" = "#2E8B57",
                "Central Plateau" = "#FF6B35",
                "Fila Costeña-San Vito" = "#9B59B6")

p_biplot <- ggplot() +
  geom_point(data = pca_scores[pca_scores$population == "Background", ],
             aes(x = PC1, y = PC2), color = "gray90", alpha = 0.3, size = 0.5) +
  geom_point(data = pca_scores[pca_scores$population %in% target_pops, ],
             aes(x = PC1, y = PC2, color = population), alpha = 0.7, size = 1.8) +
  geom_point(data = centroids, aes(x = PC1, y = PC2, color = population),
             size = 5, shape = 18) +
  geom_segment(data = var_coords_plot,
               aes(x = 0, y = 0, xend = PC1_scaled, yend = PC2_scaled),
               arrow = arrow(length = unit(0.15,"cm")), color = "blue", alpha = 0.5) +
  geom_text(data = var_coords_plot,
            aes(x = PC1_scaled * 1.15, y = PC2_scaled * 1.15, label = nice),
            color = "blue", size = 2.8) +
  geom_hline(yintercept = 0, linetype = "dashed", alpha = 0.3) +
  geom_vline(xintercept = 0, linetype = "dashed", alpha = 0.3) +
  scale_color_manual(values = pop_colors) +
  coord_cartesian(xlim = c(-x_lim, x_lim), ylim = c(-y_lim, y_lim)) +
  labs(title = "PCA – Environmental Niche of Agalychnis annae Populations",
       subtitle = paste0("PC1: ", eig$Variance_percent[1], "%, PC2: ", eig$Variance_percent[2], "%"),
       x = paste0("PC1 (", eig$Variance_percent[1], "%)"),
