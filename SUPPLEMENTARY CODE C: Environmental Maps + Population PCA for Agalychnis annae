# -----------------------------------------------------------------------------
# 4. HELPER FUNCTIONS FOR MAPS
# -----------------------------------------------------------------------------

# Convert raster to data frame (with optional subsampling)
rast_to_df <- function(r, vname, max_cells = 200000) {
  df <- as.data.frame(r, xy = TRUE, na.rm = TRUE)
  names(df)[3] <- vname
  if (nrow(df) > max_cells) {
    set.seed(123)
    df <- df[sample(nrow(df), max_cells), ]
  }
  df
}

# Publication‑ready theme for maps
theme_map <- function(base_size = 9, panel_fill = "white", grid_color = "grey80") {
  theme_minimal(base_size = base_size) +
    theme(
      plot.background  = element_rect(fill = "white", colour = NA),
      panel.background = element_rect(fill = panel_fill, colour = NA),
      panel.grid.major = element_line(colour = grid_color, linewidth = 0.3),
      panel.grid.minor = element_blank(),
      axis.title       = element_blank(),
      axis.text        = element_text(size = 6),
      plot.title       = element_text(face = "bold", hjust = 0.5, size = base_size + 1),
      plot.subtitle    = element_blank(),
      legend.position  = "none",
      plot.margin      = margin(2, 2, 2, 2)
    )
}

# Build a single map (with optional legends)
build_map <- function(var_name,
                      land_fill = "white",
                      panel_fill = "white",
                      grid_color = "grey80",
                      show_fill_legend = FALSE,
                      show_shape_legend = FALSE) {
  meta <- var_meta[[var_name]]
  if (is.null(meta)) meta <- list(title = var_name, units = "", pal = "temp")
  
  is_coffee <- (meta$pal == "coffee")
  df <- rast_to_df(env_stack[[var_name]], var_name)
  
  p <- ggplot() +
    geom_sf(data = costa_rica, fill = land_fill, colour = "black", linewidth = 0.4)
  
  if (is_coffee) {
    df_cof <- df[df[[var_name]] > 0.01, ]
    p <- p + geom_tile(data = df_cof, aes(x = x, y = y),
                       fill = coffee_fill, alpha = 0.75)
  } else {
    p <- p + geom_tile(data = df, aes(x = x, y = y, fill = .data[[var_name]]))
  }
  
  # Points: pre-2000 (circles), post-2000 (triangles)
  p <- p +
    geom_sf(data = pre_sf,  aes(shape = "Pre-2000"),
            fill = pre_fill, colour = border_col,
            size = point_size, alpha = point_alpha, stroke = stroke_w) +
    geom_sf(data = post_sf, aes(shape = "Post-2000"),
            fill = post_fill, colour = border_col,
            size = point_size, alpha = point_alpha, stroke = stroke_w)
  
  # Fill scale (continuous variables)
  if (!is_coffee) {
    pal_cols <- pals[[meta$pal]]
    p <- p + scale_fill_gradientn(
      colours = pal_cols, na.value = "transparent",
      name = meta$units,
      guide = if(show_fill_legend) {
        guide_colorbar(
          barwidth = unit(0.4, "cm"), barheight = unit(2.5, "cm"),
          title.position = "top", title.hjust = 0.5,
          frame.colour = "grey40", ticks.colour = "grey40"
        )
      } else {
        "none"
      }
    )
  }
  
  # Shape legend (time period)
  p <- p + scale_shape_manual(
    name   = "Period",
    values = c("Pre-2000" = pre_shape, "Post-2000" = post_shape),
    labels = c("Pre-2000", "Post-2000"),
    guide  = if(show_shape_legend) {
      guide_legend(
        override.aes = list(
          fill   = c(pre_fill, post_fill),
          colour = border_col,
          size   = 2,
          stroke = stroke_w
        )
      )
    } else {
      "none"
    }
  )
  
  p + coord_sf(expand = FALSE) +
    theme_map(panel_fill = panel_fill, grid_color = grid_color) +
    labs(title = meta$title)
}

# -----------------------------------------------------------------------------
# 5. GENERATE INDIVIDUAL MAPS (one per variable)
# -----------------------------------------------------------------------------

cat("\nGenerating individual maps...\n")
var_names <- names(env_stack)

for (i in seq_along(var_names)) {
  v <- var_names[i]
  cat(sprintf("  [%02d/%02d] %s\n", i, length(var_names), v))
  
  p <- tryCatch(
    build_map(v, show_fill_legend = TRUE, show_shape_legend = TRUE) +
      theme(
        legend.position = "right",
        legend.title    = element_text(face = "bold", size = 7),
        legend.text     = element_text(size = 6),
        legend.key.size = unit(0.4, "cm"),
        legend.box      = "vertical",
        legend.spacing  = unit(0.1, "cm")
      ),
    error = function(e) { cat("      ERROR:", e$message, "\n"); NULL }
  )
  
  if (!is.null(p)) {
    fbase <- file.path("output/figures/maps_30s/individual", sprintf("map_%s", v))
    ggsave(paste0(fbase, ".png"), p, width = 7, height = 5.5, dpi = 300, bg = "white")
    ggsave(paste0(fbase, ".pdf"), p, width = 7, height = 5.5, device = cairo_pdf)
  }
}
cat("Individual maps saved.\n")

# -----------------------------------------------------------------------------
# 6. VARIATIONS (alternative backgrounds and HFI palettes)
# -----------------------------------------------------------------------------

cat("\nGenerating alternative background variations...\n")

bg_list <- list(
  white = list(land = "white", panel = "white", grid = "grey80"),
  gray  = list(land = "grey90", panel = "grey95", grid = "white")
)

