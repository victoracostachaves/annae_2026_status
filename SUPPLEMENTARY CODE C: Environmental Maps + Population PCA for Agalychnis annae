        legend.position = "right",
        legend.title    = element_text(face = "bold", size = 7),
        legend.text     = element_text(size = 6),
        legend.key.size = unit(0.4, "cm"),
        legend.box      = "vertical"
      )
    
    if (v == "hfi") {
      for (pal_name in names(hfi_opts)) {
        pal <- hfi_opts[[pal_name]]
        p_hfi <- build_map("hfi", land_fill = bg$land, panel_fill = bg$panel, grid_color = bg$grid,
                           show_fill_legend = TRUE, show_shape_legend = TRUE) +
          scale_fill_gradientn(colours = pal, na.value = "transparent", name = "HFI",
                               guide = guide_colorbar(barwidth = 0.4, barheight = 2.5,
                                                      title.position = "top", title.hjust = 0.5)) +
          theme(legend.position = "right",
                legend.title = element_text(face = "bold", size = 7),
                legend.text  = element_text(size = 6),
