# -----------------------------------------------------------------------------
# 13. Wilcoxon tests
# -----------------------------------------------------------------------------

cat("\nPairwise Wilcoxon tests (PC1 and PC2):\n")
test_results <- data.frame()
for (pc in c("PC1","PC2")) {
  for (i in 1:(length(target_pops)-1)) {
    for (j in (i+1):length(target_pops)) {
      pop1 <- target_pops[i]
      pop2 <- target_pops[j]
      vals1 <- pca_scores[pca_scores$population == pop1, pc]
      vals2 <- pca_scores[pca_scores$population == pop2, pc]
      test <- wilcox.test(vals1, vals2)
      test_results <- rbind(test_results, data.frame(
        PC = pc,
        Comparison = paste(pop1, "vs", pop2),
        Mean1 = round(mean(vals1), 3),
        Mean2 = round(mean(vals2), 3),
        Difference = round(mean(vals1) - mean(vals2), 3),
        p_value = format.pval(test$p.value, digits = 4)
      ))
    }
  }
}
print(test_results)

