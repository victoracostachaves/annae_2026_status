# ============================================================================
# SUPPLEMENTARY CODE B: County-level distribution analysis for Agalychnis annae
# ============================================================================
# Original authors: Hector Zumbado and Victor Acosta
# Improved and standardized with assistance from DeepSeek (AI assistant)
# Date: 2026-05-25
#
# This script performs county-level (cantonal) analyses:
# 1. Joins occurrence records with Costa Rican county shapefiles
# 2. Creates maps of observation counts per county
# 3. Generates bar charts of observations by county and year
# 4. Analyzes latitudinal/longitudinal trends over time
# 5. Visualizes first observation year per county
#
# Required files (relative paths):
#   data/processed/Agalychnis_annae_full_dataset.rds  - cleaned occurrences
#   shapefiles/ - shapefiles with patterns 'co', 'cr', 'can' (countries, costa rica, counties, provincias)
#   shapefiles/annae_occs.gpkg (optional; will be created if missing)
#
# Outputs saved to:
#   data/processed/ - CSV summaries
#   output/figures/ - JPG maps and plots
# ============================================================================

# ============================================================================
# 0. SETUP
# ============================================================================

rm(list = ls())

library(sf)
library(tmap)
library(tidyverse)
library(ggplot2)

# Create directories if they don't exist
dir.create("data/processed", showWarnings = FALSE, recursive = TRUE)
dir.create("output/figures", showWarnings = FALSE, recursive = TRUE)

my_species <- "Agalychnis_annae"

# ============================================================================
# 1. LOAD SHAPEFILES
# ============================================================================

# Expected shapefile patterns: 'co' (countries), 'cr' (costa rica polygon),
# 'can' (counties/cantones), and optionally 'provincias'
shapefiles <- list.files("shapefiles",
                         pattern = "(co|cr|can)",
                         full.names = TRUE)

if (length(shapefiles) < 3) {
  stop("Required shapefiles not found. Please ensure shapefiles with patterns 'co', 'cr', 'can' are in the 'shapefiles/' folder.")
}

shp_list <- map(shapefiles, ~ read_sf(.x) %>% st_make_valid())
names(shp_list) <- c("costa_rica", "counties", "countries", "provincias")[1:length(shp_list)]
list2env(shp_list, .GlobalEnv)

# ============================================================================
# 2. LOAD OCCURRENCE DATA
# ============================================================================

annae_cr <- read_rds(paste0("data/processed/", my_species, "_full_dataset.rds")) %>%
  filter(id != "Panama")   # Keep only Costa Rica records

# ============================================================================
# 3. CREATE SPATIAL OBJECT (if not already saved from script 07)
# ============================================================================

gpkg_path <- "shapefiles/annae_occs.gpkg"

if (file.exists(gpkg_path)) {
  annae_cr_sf <- read_sf(gpkg_path)
} else {
  message("Creating annnae_occs.gpkg from occurrence data...")
  annae_cr_sf <- annae_cr %>%
    st_as_sf(coords = c("x", "y"), crs = 4326, remove = FALSE) %>%
    st_join(counties) %>%
    select(id:accuracy, canton, cod, source, everything())
  
  # Save for future use
  write_sf(annae_cr_sf, gpkg_path)
}

# ============================================================================
# 4. SUBSET COUNTIES WITH OCCURRENCES
# ============================================================================

counties_annae <- counties %>% st_filter(annae_cr_sf)

# ============================================================================
# 5. EXPORT SUMMARY TABLE (observations per county and time period)
# ============================================================================

annae_cr_sf %>%
  as_tibble() %>%
  mutate(time = if_else(year >= 2000, "postdecline", "decline")) %>%
  summarize(n = n(), .by = c(canton, time)) %>%
  arrange(canton) %>%
  write_csv(paste0("data/processed/", my_species, "_total_obs.csv"))

# ============================================================================
# 6. MAP: OBSERVATIONS PER COUNTY (CHOROPLETH + POINTS)
# ============================================================================

# Join counts to county polygons
counties_count <- annae_cr_sf %>%
  as_tibble() %>%
  summarize(n = n(), .by = canton) %>%
  full_join(counties, ., by = "canton")

# Static map
counties_map <- costa_rica %>%
  tm_shape() +
  tm_borders("gray10") +
  tm_shape(counties_count) +
  tm_polygons(
    fill = "n",
    fill.scale = tm_scale_continuous(
      values = "-orange_blue_diverging",
      value.na = "gray90",
      label.na = "Not recorded"
    ),
    fill.legend = tm_legend("Observations", orientation = "landscape", frame = TRUE, width = 60),
    col = NULL
  ) +
  tm_shape(annae_cr_sf) +
  tm_symbols(size = 0.25, fill = "red") +
  tm_shape(provincias) +
  tm_borders(lwd = 1) +
  tm_compass(position = c("right", "top"), size = 1) +
  tm_scalebar(breaks = c(0, 50, 100), text.size = 0.75, position = c("left", "bottom"))

# Save static map
tmap_save(counties_map,
          paste0("output/figures/", my_species, "_distribution_counties.jpg"),
          height = 7, width = 8, dpi = 300)

# Interactive view (optional)
# tmap_mode("view")
# counties_map

# ============================================================================
# 7. BAR CHART: OBSERVATIONS PER COUNTY (HISTORICAL)
# ============================================================================

county_history <- annae_cr_sf %>%
  group_by(canton) %>%
  summarize(n = n()) %>%
  ggplot(aes(x = reorder(canton, n), y = n)) +
  geom_bar(stat = "identity", fill = "cornflowerblue", col = "black") +
  coord_flip() +
  scale_y_continuous(expand = c(0, 0), breaks = c(0, 20, 40, 60, 80)) +
  labs(x = "County", y = "Observations") +
  theme_classic()

ggsave(paste0("output/figures/", my_species, "_observation_counties.jpg"),
       plot = county_history, dpi = 300)

# ============================================================================
# 8. BAR CHART: OBSERVATIONS PER YEAR
# ============================================================================

dist_temp <- annae_cr_sf %>%
  group_by(year) %>%
  summarize(n = n()) %>%
  ggplot(aes(year, n)) +
  geom_bar(stat = "identity", col = "black", fill = "cornflowerblue") +
  scale_y_continuous(limits = c(0, 80), expand = c(0, 0)) +
  labs(x = "Year", y = "Observations since 1950") +
  theme_classic()

ggsave(paste0("output/figures/", my_species, "_observation_year.jpg"),
       plot = dist_temp, dpi = 300)

# ============================================================================
# 9. BAR CHART: OBSERVATIONS PER COUNTY (SINCE 2000)
# ============================================================================

dist_temp2 <- annae_cr_sf %>%
  filter(year %in% 2000:2025) %>%
  group_by(canton) %>%
  summarize(n = n()) %>%
  ggplot(aes(x = reorder(canton, n), y = n)) +
  geom_bar(stat = "identity", fill = "tan") +
  coord_flip() +
  scale_y_continuous(expand = c(0, 0)) +
  labs(title = "Observations of Agalychnis annae by county since 2000",
       x = "County", y = "Number of observations") +
  theme_classic()

print(dist_temp2)
# Optional: ggsave if needed (commented)
# ggsave("output/figures/annae_post2000_counties.jpg", plot = dist_temp2, dpi = 300)

# ============================================================================
# 10. LATITUDINAL TRENDS OVER TIME
# ============================================================================

lat <- annae_cr_sf %>%
  group_by(year) %>%
  summarize(sur = min(y), norte = max(y)) %>%
  pivot_longer(sur:norte, names_to = "limites", values_to = "latitud") %>%
  ggplot(aes(x = year, y = latitud)) +
  geom_point() +
  geom_line(aes(col = limites)) +
  scale_color_manual(values = c("blue", "orange"), name = "Limits",
                     labels = c("North", "South")) +
  labs(x = "Year", y = "Latitude") +
  theme_classic() +
  theme(legend.title = element_text(size = 20),
        legend.text = element_text(size = 16),
        legend.position.inside = c(0.5, 0.3),
        legend.background = element_rect(fill = "gray90", linewidth = 0.5,
                                         linetype = "solid", colour = "gray20"))

ggsave(paste0("output/figures/", my_species, "_observation_latitude.jpg"),
       plot = lat, dpi = 300)

# ============================================================================
# 11. LONGITUDINAL TRENDS OVER TIME
# ============================================================================

long <- annae_cr_sf %>%
  group_by(year) %>%
  summarize(oeste = min(x), este = max(x)) %>%
  pivot_longer(oeste:este, names_to = "limites", values_to = "longitud") %>%
  ggplot(aes(x = year, y = longitud)) +
  geom_point() +
  geom_line(aes(col = limites)) +
  scale_color_manual(values = c("blue", "orange"), name = "Limits",
                     labels = c("West", "East")) +
  labs(x = "Year", y = "Longitude") +
  theme_classic() +
  theme(legend.title = element_text(size = 20),
        legend.text = element_text(size = 16),
        legend.position.inside = c(0.5, 0.3),
        legend.background = element_rect(fill = "gray90", linewidth = 0.5,
                                         linetype = "solid", colour = "gray20"))

ggsave(paste0("output/figures/", my_species, "_observation_longitude.jpg"),
       plot = long, dpi = 300)

# ============================================================================
# 12. DENSITY PLOTS OF COORDINATES
# ============================================================================

longlat <- annae_cr_sf %>%
  filter(x >= -86, x <= -82, y >= 8, y <= 12) %>%
  pivot_longer(c(x, y), names_to = "axis", values_to = "coordinates") %>%
  mutate(axis = factor(axis, levels = c("x", "y"))) %>%
  ggplot(aes(x = coordinates)) +
  geom_density(fill = "salmon") +
  facet_wrap(~ axis, scales = "free") +
  scale_y_continuous(expand = c(0, 0)) +
  labs(title = "Density of observations by latitude and longitude",
       x = "Coordinates", y = "Density") +
  theme_classic()

print(longlat)
# Optional save (commented)
# ggsave("output/figures/annae_coord_density.jpg", plot = longlat, dpi = 300)

# ============================================================================
# 13. FIRST OBSERVATION YEAR PER COUNTY
# ============================================================================

first_observation <- annae_cr_sf %>%
  group_by(canton) %>%
  filter(year == min(year)) %>%
  ggplot(aes(x = reorder(canton, desc(year)), y = year)) +
  geom_segment(aes(xend = canton, y = 2022, yend = year), color = "#6f8faf") +
  geom_point(color = "#6f8faf", size = 4) +
  coord_flip() +
  labs(x = "County", y = "Year") +
  theme_classic()

ggsave(paste0("output/figures/", my_species, "_first_observation.jpg"),
       plot = first_observation, dpi = 300)

# ============================================================================
# 14. ALL OBSERVATIONS PER COUNTY (LADDER PLOT)
# ============================================================================

all_observations <- annae_cr_sf %>%
  ggplot(aes(x = reorder(canton, desc(year)), y = year)) +
  geom_segment(aes(xend = canton, y = 2022, yend = year), color = "cornflowerblue") +
  geom_point(colour = "black", fill = "cornflowerblue", size = 4, shape = 21) +
  coord_flip() +
  labs(x = "County", y = "Year") +
  theme_classic()

ggsave(paste0("output/figures/", my_species, "_all_observations.jpg"),
       plot = all_observations, dpi = 300)

# ============================================================================
# 15. SUMMARY STATISTICS (CONSOLE OUTPUT)
# ============================================================================

cat("\n=== Summary of observations by province ===\n")
annae_cr_sf %>%
  as_tibble() %>%
  summarise(n = n(), .by = provincia) %>%
  print()

cat("\n=== Top 10 counties by observation count ===\n")
annae_cr_sf %>%
  as_tibble() %>%
  group_by(canton) %>%
  summarise(n = n()) %>%
  arrange(desc(n)) %>%
  slice(1:10) %>%
  print()

cat("\nAll outputs saved to 'output/figures/' and 'data/processed/'\n")

# ============================================================================
# END OF SUPPLEMENTARY CODE B
